{
  "name": "tile-floor-calculator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
